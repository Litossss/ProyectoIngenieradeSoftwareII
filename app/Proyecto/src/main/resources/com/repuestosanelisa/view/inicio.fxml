<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!-- Pantalla 2: Panel principal (dashboard) -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.repuestosanelisa.controller.InicioController" spacing="14" styleClass="vista">

    <HBox spacing="14">
        <VBox styleClass="kpi-card" spacing="10" HBox.hgrow="ALWAYS" maxWidth="Infinity">
            <Label text="Productos registrados" styleClass="kpi-titulo"/>
            <Label fx:id="lblProductos" text="-" styleClass="kpi-valor"/>
        </VBox>
        <VBox styleClass="kpi-card, kpi-alerta" spacing="10" HBox.hgrow="ALWAYS" maxWidth="Infinity">
            <Label text="Productos con poco stock" styleClass="kpi-titulo"/>
            <Label fx:id="lblPocoStock" text="-" styleClass="kpi-valor"/>
        </VBox>
        <VBox styleClass="kpi-card" spacing="10" HBox.hgrow="ALWAYS" maxWidth="Infinity">
            <Label text="Ventas de hoy" styleClass="kpi-titulo"/>
            <Label fx:id="lblVentasHoy" text="-" styleClass="kpi-valor"/>
        </VBox>
        <VBox fx:id="cardCompras" styleClass="kpi-card" spacing="10" HBox.hgrow="ALWAYS" maxWidth="Infinity">
            <Label text="Compras del mes" styleClass="kpi-titulo"/>
            <Label fx:id="lblComprasMes" text="-" styleClass="kpi-valor"/>
        </VBox>
    </HBox>

    <HBox spacing="14" VBox.vgrow="ALWAYS">
        <VBox spacing="6" HBox.hgrow="ALWAYS" maxWidth="Infinity">
            <Label text="Últimas ventas" styleClass="seccion"/>
            <TableView fx:id="tablaVentas" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colVFecha" text="Fecha" prefWidth="70"/>
                    <TableColumn fx:id="colVProducto" text="Producto" prefWidth="200"/>
                    <TableColumn fx:id="colVCant" text="Cant." prefWidth="60"/>
                    <TableColumn fx:id="colVTotal" text="Total" prefWidth="110"/>
                </columns>
                <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
            </TableView>
        </VBox>
        <VBox spacing="6" HBox.hgrow="ALWAYS" maxWidth="Infinity">
            <Label text="Productos con poco stock" styleClass="seccion"/>
            <TableView fx:id="tablaPoco" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colPCodigo" text="Código" prefWidth="90"/>
                    <TableColumn fx:id="colPProducto" text="Producto" prefWidth="220"/>
                    <TableColumn fx:id="colPStock" text="Stock" prefWidth="70"/>
                </columns>
                <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
            </TableView>
        </VBox>
    </HBox>

    <Label text="Accesos rápidos" styleClass="seccion"/>
    <HBox spacing="14">
        <Button text="+ NUEVA VENTA" onAction="#nuevaVenta" styleClass="btn-primary" HBox.hgrow="ALWAYS" maxWidth="Infinity" prefHeight="46"/>
        <Button text="CONSULTAR INVENTARIO" onAction="#consultarInventario" styleClass="btn-secondary" HBox.hgrow="ALWAYS" maxWidth="Infinity" prefHeight="46"/>
        <VBox fx:id="boxReporte" spacing="3" HBox.hgrow="ALWAYS" maxWidth="Infinity">
            <Button text="GENERAR REPORTE" onAction="#generarReporte" styleClass="btn-secondary" maxWidth="Infinity" prefHeight="46"/>
        </VBox>
    </HBox>
</VBox>
