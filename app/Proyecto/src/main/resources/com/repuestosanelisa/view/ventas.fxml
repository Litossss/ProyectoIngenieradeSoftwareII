<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- Pantalla 5: Registro de ventas (salidas) -->
<HBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.repuestosanelisa.controller.VentasController" spacing="18" styleClass="vista">

    <VBox spacing="8" HBox.hgrow="ALWAYS" maxWidth="Infinity" prefWidth="480">
        <Label text="1. Buscar producto" styleClass="seccion"/>
        <HBox spacing="8">
            <TextField fx:id="txtBuscar" promptText="Nombre o código..." HBox.hgrow="ALWAYS" onAction="#buscar"/>
            <Button text="Buscar" onAction="#buscar" styleClass="btn-primary"/>
        </HBox>
        <TableView fx:id="tablaProductos" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colPCodigo" text="Código" prefWidth="90"/>
                <TableColumn fx:id="colPProducto" text="Producto" prefWidth="220"/>
                <TableColumn fx:id="colPStock" text="Stock" prefWidth="60"/>
                <TableColumn fx:id="colPAgregar" text="" prefWidth="90" sortable="false"/>
            </columns>
            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
        </TableView>

        <Label text="Cliente (opcional)" styleClass="etiqueta"/>
        <TextField fx:id="txtCliente" promptText="Nombre del cliente"/>
        <Label fx:id="lblUsuario" styleClass="nota"/>
        <Label fx:id="lblFecha" styleClass="nota"/>
    </VBox>

    <VBox spacing="8" HBox.hgrow="ALWAYS" maxWidth="Infinity" prefWidth="480">
        <Label text="2. Detalle de la venta" styleClass="seccion"/>
        <TableView fx:id="tablaDetalle" editable="true" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colDProducto" text="Producto" prefWidth="190" sortable="false"/>
                <TableColumn fx:id="colDCant" text="Cant." prefWidth="60" sortable="false"/>
                <TableColumn fx:id="colDPrecio" text="Precio" prefWidth="90" sortable="false"/>
                <TableColumn fx:id="colDSubtotal" text="Subtotal" prefWidth="100" sortable="false"/>
                <TableColumn fx:id="colDQuitar" text="" prefWidth="40" sortable="false"/>
            </columns>
            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
        </TableView>

        <HBox styleClass="total-box" alignment="CENTER_LEFT">
            <Label text="TOTAL:"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="lblTotal" text="\$ 0" styleClass="total-valor"/>
        </HBox>

        <Label fx:id="lblError" styleClass="error-box" visible="false" managed="false" wrapText="true" maxWidth="Infinity"/>

        <HBox spacing="12">
            <Button text="CANCELAR" onAction="#cancelar" styleClass="btn-secondary" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
            <Button text="REGISTRAR VENTA" onAction="#registrar" styleClass="btn-primary" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
        </HBox>
    </VBox>
</HBox>
