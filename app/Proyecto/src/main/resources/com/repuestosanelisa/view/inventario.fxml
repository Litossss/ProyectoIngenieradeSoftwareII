<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- Pantalla 3: Inventario y consulta rápida (RF05) -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.repuestosanelisa.controller.InventarioController" spacing="12" styleClass="vista">

    <HBox spacing="12" alignment="BOTTOM_LEFT">
        <VBox spacing="4" HBox.hgrow="ALWAYS" maxWidth="Infinity">
            <Label text="Buscar por nombre, código o categoría" styleClass="etiqueta"/>
            <TextField fx:id="txtBuscar" promptText="Ej: filtro de aceite..." onAction="#buscar"/>
        </VBox>
        <VBox spacing="4">
            <Label text="Categoría" styleClass="etiqueta"/>
            <ComboBox fx:id="cmbCategoria" prefWidth="190"/>
        </VBox>
        <Button text="Buscar" onAction="#buscar" styleClass="btn-primary"/>
        <Button text="+ NUEVO PRODUCTO" onAction="#nuevoProducto" styleClass="btn-secondary"/>
    </HBox>

    <TableView fx:id="tabla" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colFoto" text="Foto" prefWidth="70" sortable="false"/>
            <TableColumn fx:id="colCodigo" text="Código" prefWidth="90"/>
            <TableColumn fx:id="colNombre" text="Nombre" prefWidth="250"/>
            <TableColumn fx:id="colCategoria" text="Categoría" prefWidth="120"/>
            <TableColumn fx:id="colCantidad" text="Cant." prefWidth="70"/>
            <TableColumn fx:id="colPrecio" text="Precio" prefWidth="110"/>
            <TableColumn fx:id="colProveedor" text="Proveedor" prefWidth="120"/>
            <TableColumn fx:id="colAcciones" text="Acciones" prefWidth="140" sortable="false"/>
        </columns>
        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
    </TableView>

    <HBox alignment="CENTER_LEFT" spacing="8">
        <Label fx:id="lblResumen" styleClass="nota"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="btnAnterior" text="&lt;" onAction="#paginaAnterior" styleClass="btn-secondary"/>
        <Label fx:id="lblPagina" styleClass="etiqueta"/>
        <Button fx:id="btnSiguiente" text="&gt;" onAction="#paginaSiguiente" styleClass="btn-secondary"/>
    </HBox>

    <Label styleClass="info-box" wrapText="true" maxWidth="Infinity"
           text="Si no hay coincidencias: &quot;No se encontraron productos&quot;. Una fila con cantidad 0 o baja se resalta como alerta de stock."/>
</VBox>
