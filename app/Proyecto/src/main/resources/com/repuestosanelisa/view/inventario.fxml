<?xml version="1.0" encoding="UTF-8"?>

        <?import javafx.scene.control.Button?>
        <?import javafx.scene.control.Label?>
        <?import javafx.scene.control.TableColumn?>
        <?import javafx.scene.control.TableView?>
        <?import javafx.scene.layout.HBox?>
        <?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.repuestosanelisa.controller.InventarioController"
      spacing="15"
      prefWidth="800"
      prefHeight="500"
      style="-fx-padding: 20;">

    <Label text="Inventario de repuestos"
           style="-fx-font-size: 22px; -fx-font-weight: bold;"/>

    <TableView fx:id="tablaProductos" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colCodigo" text="Código" prefWidth="120"/>
            <TableColumn fx:id="colNombre" text="Nombre" prefWidth="220"/>
            <TableColumn fx:id="colCantidad" text="Cantidad" prefWidth="120"/>
            <TableColumn fx:id="colPrecio" text="Precio" prefWidth="150"/>
        </columns>
    </TableView>

    <HBox spacing="10">
        <Button text="Agregar" onAction="#agregarProducto"/>
        <Button text="Editar" onAction="#editarProducto"/>
        <Button text="Eliminar" onAction="#eliminarProducto"/>
    </HBox>

</VBox>