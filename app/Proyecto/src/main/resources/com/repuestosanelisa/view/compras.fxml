<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- Pantalla 6: Registro de compras a proveedor (entradas) — solo Administrador -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.repuestosanelisa.controller.ComprasController" spacing="10" styleClass="vista">

    <HBox spacing="14" alignment="BOTTOM_LEFT">
        <VBox spacing="4" HBox.hgrow="ALWAYS" maxWidth="Infinity">
            <Label text="Proveedor *" styleClass="etiqueta"/>
            <HBox spacing="8">
                <ComboBox fx:id="cmbProveedor" promptText="Seleccione un proveedor..." HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                <Button text="+ Nuevo proveedor" onAction="#nuevoProveedor" styleClass="btn-secondary"/>
            </HBox>
        </VBox>
        <VBox spacing="4">
            <Label text="Fecha" styleClass="etiqueta"/>
            <DatePicker fx:id="dpFecha" promptText="dd/mm/aaaa" prefWidth="190"/>
        </VBox>
    </HBox>

    <HBox alignment="CENTER_LEFT">
        <Label text="Productos comprados" styleClass="seccion"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="+ Agregar producto" onAction="#agregarProducto" styleClass="btn-secondary"/>
    </HBox>

    <TableView fx:id="tabla" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colCodigo" text="Código" prefWidth="100" sortable="false"/>
            <TableColumn fx:id="colProducto" text="Producto" prefWidth="280" sortable="false"/>
            <TableColumn fx:id="colCantidad" text="Cantidad" prefWidth="100" sortable="false"/>
            <TableColumn fx:id="colCosto" text="Costo unit." prefWidth="120" sortable="false"/>
            <TableColumn fx:id="colSubtotal" text="Subtotal" prefWidth="120" sortable="false"/>
            <TableColumn fx:id="colQuitar" text="" prefWidth="90" sortable="false"/>
        </columns>
        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
    </TableView>

    <HBox spacing="14" alignment="CENTER_LEFT">
        <Label fx:id="lblError" styleClass="error-box" visible="false" managed="false" wrapText="true" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
        <Region HBox.hgrow="ALWAYS"/>
        <HBox styleClass="total-box" alignment="CENTER_LEFT" prefWidth="360" minWidth="360">
            <Label text="TOTAL COMPRA:"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="lblTotal" text="\$ 0" styleClass="total-valor"/>
        </HBox>
    </HBox>

    <HBox spacing="12" alignment="CENTER_LEFT">
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="CANCELAR" onAction="#cancelar" styleClass="btn-secondary" minWidth="150"/>
        <Button text="REGISTRAR COMPRA" onAction="#registrar" styleClass="btn-primary" minWidth="190"/>
    </HBox>
</VBox>
